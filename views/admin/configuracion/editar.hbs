<div class="container mt-3">
   <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="settings-shell">
    <div class="card">
      <h5 class="mb-3">Editar configuración</h5>
      {{#if errores}}
        <div class="alert alert-danger"><ul class="mb-0">{{#each errores}}<li>{{this.msg}}</li>{{/each}}</ul></div>
      {{/if}}
      <form method="POST" action="/admin/configuracion/editar">
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">ITBIS (%)</label><input type="number" step="0.01" name="itbis" class="form-control" value="{{config.itbis}}" required></div>
        </div>
        <div class="d-flex gap-2 mt-4">
          <a href="/admin/configuracion" class="btn btn-outline-secondary">Volver</a>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
