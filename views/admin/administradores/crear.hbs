<div class="container mt-3">
    <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="settings-shell">
    <div class="card">
      <h5 class="mb-3">Crear administrador</h5>
      {{#if errores}}
        <div class="alert alert-danger"><ul class="mb-0">{{#each errores}}<li>{{this.msg}}</li>{{/each}}</ul></div>
      {{/if}}
      <form method="POST" action="/admin/administradores/crear">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Nombre</label><input type="text" name="nombre" class="form-control" value="{{datos.nombre}}" required></div>
          <div class="col-md-6"><label class="form-label">Apellido</label><input type="text" name="apellido" class="form-control" value="{{datos.apellido}}" required></div>
          <div class="col-md-6"><label class="form-label">Cédula</label><input type="text" name="cedula" class="form-control" value="{{datos.cedula}}" required></div>
          <div class="col-md-6"><label class="form-label">Correo</label><input type="email" name="correo" class="form-control" value="{{datos.correo}}" required></div>
          <div class="col-md-6"><label class="form-label">Usuario</label><input type="text" name="usuario" class="form-control" value="{{datos.usuario}}" required></div>
          <div class="col-md-6"></div>
          <div class="col-md-6"><label class="form-label">Contraseña</label><input type="password" name="password" class="form-control" required></div>
          <div class="col-md-6"><label class="form-label">Confirmar contraseña</label><input type="password" name="confirmarPassword" class="form-control" required></div>
        </div>
        <div class="d-flex gap-2 mt-4">
          <a href="/admin/administradores" class="btn btn-outline-secondary">Volver</a>
          <button type="submit" class="btn btn-primary">Crear administrador</button>
        </div>
      </form>
    </div>
  </div>
</div>
