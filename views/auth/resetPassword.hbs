<div class="auth-shell">
  <div class="auth-visual">
    <i class="ti ti-key" style="font-size:40px;"></i>
    <h2 class="mt-3">Elige una nueva contraseña.</h2>
    <p>Asegúrate de que sea segura y fácil de recordar.</p>
  </div>
  <div class="auth-form-col">
    <div class="auth-form-panel">
      <img src="/img/cenar-wordmark-color.svg" style="height:40px;" class="mb-4 d-lg-none">
      <h4 class="mb-1">Nueva contraseña</h4>

      {{#if error}}
        <div class="alert alert-danger">{{error}}</div>
      {{/if}}

      <form method="POST" action="/reset-password/{{token}}">
        <div class="mb-3"><label class="form-label">Nueva contraseña</label><input type="password" name="password" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Confirmar contraseña</label><input type="password" name="confirmarPassword" class="form-control" required></div>
        <button type="submit" class="btn btn-primary w-100">Guardar nueva contraseña</button>
      </form>
      <a href="/login" class="text-center small d-block mt-3">Volver al login</a>
    </div>
  </div>
</div>
