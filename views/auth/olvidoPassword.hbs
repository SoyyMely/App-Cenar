<div class="auth-shell">
  <div class="auth-visual">
    <i class="ti ti-lock" style="font-size:40px;"></i>
    <h2 class="mt-3">Te ayudamos a recuperar el acceso.</h2>
    <p>Te enviaremos un enlace seguro a tu correo para restablecer tu contraseña.</p>
  </div>
  <div class="auth-form-col">
    <div class="auth-form-panel">
      <img src="/img/cenar-wordmark-color.svg" style="height:40px;" class="mb-4 d-lg-none">
      <h4 class="mb-1">Recuperar contraseña</h4>
      <p class="text-muted mb-4">Te enviaremos un enlace a tu correo</p>

      {{#if error}}
        <div class="alert alert-danger">{{error}}</div>
      {{/if}}

      <form method="POST" action="/olvido-password">
        <div class="mb-3"><label class="form-label">Usuario o correo</label><input type="text" name="usuarioOCorreo" class="form-control" required></div>
        <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
      </form>
      <a href="/login" class="text-center small d-block mt-3">Volver al login</a>
    </div>
  </div>
</div>
