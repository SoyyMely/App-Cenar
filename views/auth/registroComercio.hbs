<div class="auth-shell">
  <div class="auth-visual">
    <i class="ti ti-building-store" style="font-size:40px;"></i>
    <h2 class="mt-3">Lleva tu negocio a más clientes.</h2>
    <p>Registra tu comercio y empieza a recibir pedidos en Cenar.</p>
  </div>
  <div class="auth-form-col">
    <div class="auth-form-panel wide">
      <img src="/img/cenar-wordmark-color.svg" style="height:36px;" class="mb-4 d-lg-none">
      <h4 class="mb-1">Registrar comercio</h4>
      <p class="text-muted mb-4">Da de alta tu negocio en Cenar</p>

      {{#if errores}}
        <div class="alert alert-danger"><ul class="mb-0">{{#each errores}}<li>{{this.msg}}</li>{{/each}}</ul></div>
      {{/if}}

      <form method="POST" action="/registro-comercio" enctype="multipart/form-data">
        <div class="row g-3 mb-2">
          <div class="col-md-6"><label class="form-label">Nombre del comercio</label><input type="text" name="nombreComercio" class="form-control" value="{{datos.nombreComercio}}" required></div>
          <div class="col-md-6"><label class="form-label">Teléfono</label><input type="text" name="telefono" class="form-control" value="{{datos.telefono}}" required></div>
          <div class="col-md-6"><label class="form-label">Correo</label><input type="email" name="correo" class="form-control" value="{{datos.correo}}" required></div>
          <div class="col-md-6"><label class="form-label">Logo del comercio</label><input type="file" name="logo" class="form-control" accept="image/*"></div>
          <div class="col-md-4"><label class="form-label">Hora de apertura</label><input type="time" name="horaApertura" class="form-control" required></div>
          <div class="col-md-4"><label class="form-label">Hora de cierre</label><input type="time" name="horaCierre" class="form-control" required></div>
          <div class="col-md-4"><label class="form-label">Tipo de comercio</label>
            <select name="tipoComercio" class="form-select" required>
              <option value="">Selecciona</option>
              {{#each tipos}}<option value="{{this._id}}">{{this.nombre}}</option>{{/each}}
            </select>
          </div>
          <div class="col-md-6"><label class="form-label">Contraseña</label><input type="password" name="password" class="form-control" required></div>
          <div class="col-md-6"><label class="form-label">Confirmar contraseña</label><input type="password" name="confirmarPassword" class="form-control" required></div>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-3">Registrar comercio</button>
      </form>
      <a href="/login" class="text-center small d-block mt-3">Ya tengo cuenta, iniciar sesión</a>
    </div>
  </div>
</div>
