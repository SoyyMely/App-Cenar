<div class="auth-shell">
  <div class="auth-visual">
    <i class="ti ti-motorbike" style="font-size:40px;"></i>
    <h2 class="mt-3">Pide lo que se te antoje, cuando quieras.</h2>
    <p>Restaurantes, mercados, farmacias y más, todo en un solo lugar.</p>
  </div>
  <div class="auth-form-col">
    <div class="auth-form-panel">
      <img src="/img/cenar-wordmark-color.svg" style="height:40px;" class="mb-4 d-lg-none">
      <h4 class="mb-1">Bienvenido de vuelta</h4>
      <p class="text-muted mb-4">Inicia sesión para pedir en Cenar</p>

      {{#if error}}
        <div class="alert alert-danger">{{error}}</div>
      {{/if}}

      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label">Usuario o correo</label>
          <input type="text" name="usuarioOCorreo" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Contraseña</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100 mb-2">Ingresar</button>
      </form>

      <a href="/olvido-password" class="text-center small d-block mb-4">¿Olvidaste tu contraseña?</a>
      <hr>
      <div class="row g-2">
        <div class="col-sm-6"><a href="/registro" class="btn btn-outline-secondary w-100"><i class="ti ti-user-plus"></i> Soy cliente</a></div>
        <div class="col-sm-6"><a href="/registro-comercio" class="btn btn-outline-secondary w-100"><i class="ti ti-building-store"></i> Soy comercio</a></div>
      </div>
    </div>
  </div>
</div>
