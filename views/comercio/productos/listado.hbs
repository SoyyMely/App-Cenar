<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><a href="/comercio" class="btn btn-sm btn-outline-secondary me-1">Pedidos</a><a href="/comercio/categorias" class="btn btn-sm btn-outline-secondary me-1">Categorías</a><a href="/comercio/productos" class="btn btn-sm btn-primary me-1">Productos</a><a href="/comercio/perfil" class="btn btn-sm btn-outline-secondary me-1">Mi perfil</a></div><a href="/logout" class="btn btn-sm btn-outline-danger">Cerrar sesión</a></div>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Mis productos</h4>
    <a href="/comercio/productos/crear" class="btn btn-primary btn-sm">+ Nuevo producto</a>
  </div>

  <div class="row">
    {{#each productos}}
      <div class="col-md-4 mb-3">
        <div class="card">
          <img src="{{this.foto}}" class="card-img-top" style="height:150px; object-fit:cover;">
          <div class="card-body">
            <h5 class="card-title">{{this.nombre}}</h5>
            <p class="card-text small">{{this.descripcion}}</p>
            <p class="text-muted small">Categoría: {{this.categoria.nombre}}</p>
            <p><strong>RD$ {{this.precio}}</strong></p>
            <a href="/comercio/productos/{{this._id}}/editar" class="btn btn-sm btn-outline-primary">Editar</a>
            <a href="/comercio/productos/{{this._id}}/eliminar" class="btn btn-sm btn-outline-danger">Eliminar</a>
          </div>
        </div>
      </div>
    {{else}}
      <p>No tienes productos creados.</p>
    {{/each}}
  </div>

  <a href="/comercio" class="btn btn-secondary mt-3">Volver</a>
</div>
