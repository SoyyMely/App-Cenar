<div class="container mt-3 text-center" style="max-width:500px;">
  <h4 class="mb-4 text-danger">¿Está seguro?</h4>
  <p>¿Está seguro que desea eliminar la categoría <strong>{{categoria.nombre}}</strong>?</p>
  <form method="POST" action="/comercio/categorias/{{categoria._id}}/eliminar" class="d-flex gap-2 justify-content-center">
    <a href="/comercio/categorias" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-danger">Aceptar</button>
  </form>
</div>
