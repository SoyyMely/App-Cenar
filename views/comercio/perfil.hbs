<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><a href="/comercio" class="btn btn-sm btn-outline-secondary me-1">Pedidos</a><a href="/comercio/categorias" class="btn btn-sm btn-outline-secondary me-1">Categorías</a><a href="/comercio/productos" class="btn btn-sm btn-outline-secondary me-1">Productos</a><a href="/comercio/perfil" class="btn btn-sm btn-primary me-1">Mi perfil</a></div><a href="/logout" class="btn btn-sm btn-outline-danger">Cerrar sesión</a></div>
  <div class="settings-shell">
    <div class="card">
      {{#if errores}}
        <div class="alert alert-danger"><ul class="mb-0">{{#each errores}}<li>{{this.msg}}</li>{{/each}}</ul></div>
      {{/if}}

      <div class="row align-items-center mb-4">
        <div class="col-auto">
          {{#if comercio.foto}}
            <img src="{{comercio.foto}}" style="width:88px;height:88px;object-fit:cover;border-radius:50%;">
          {{/if}}
        </div>
        <div class="col"><h5 class="mb-0">Mi perfil</h5></div>
      </div>

      <form method="POST" action="/comercio/perfil" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-6" style="max-width:320px;">
            <label class="form-label">Logo</label>
            <input type="file" name="logo" class="form-control" accept="image/*">
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-md-6"><label class="form-label">Hora de apertura</label><input type="time" name="horaApertura" class="form-control" value="{{comercio.horaApertura}}" required></div>
          <div class="col-md-6"><label class="form-label">Hora de cierre</label><input type="time" name="horaCierre" class="form-control" value="{{comercio.horaCierre}}" required></div>
          <div class="col-md-6"><label class="form-label">Teléfono</label><input type="text" name="telefono" class="form-control" value="{{comercio.telefono}}" required></div>
          <div class="col-md-6"><label class="form-label">Correo</label><input type="email" name="correo" class="form-control" value="{{comercio.correo}}" required></div>
        </div>
        <div class="d-flex gap-2 mt-4">
          <a href="/comercio" class="btn btn-outline-secondary">Volver</a>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>
