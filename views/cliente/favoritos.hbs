<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><a href="/cliente" class="btn btn-sm btn-outline-secondary me-1">Home</a><a href="/cliente/pedidos" class="btn btn-sm btn-outline-secondary me-1">Mis pedidos</a><a href="/cliente/direcciones" class="btn btn-sm btn-outline-secondary me-1">Mis direcciones</a><a href="/cliente/favoritos" class="btn btn-sm btn-primary me-1">Mis favoritos</a><a href="/cliente/perfil" class="btn btn-sm btn-outline-secondary me-1">Mi perfil</a></div><a href="/logout" class="btn btn-sm btn-outline-danger">Cerrar sesión</a></div>
  <h4 class="mb-1">Favoritos</h4>
  <p class="text-muted small mb-3">Pide a donde más te gusta</p>

  {{#each favoritos}}
    <div class="card mb-2 p-3 d-flex flex-row align-items-center gap-3">
      <a href="/cliente/comercios/{{this._id}}/catalogo" class="d-flex align-items-center gap-3 text-decoration-none text-dark flex-grow-1">
        <img src="{{this.foto}}" style="width:50px;height:50px;object-fit:cover;border-radius:50%;">
        <span>{{this.nombreComercio}}</span>
      </a>
      <form method="POST" action="/cliente/favoritos/{{this._id}}/remover">
        <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
      </form>
    </div>
  {{else}}
    <p>No tienes comercios favoritos todavía.</p>
  {{/each}}

  <a href="/cliente" class="btn btn-secondary mt-3">Volver</a>
</div>
