<div class="container mt-3 text-center" style="max-width:500px;">
  <h4 class="mb-4 text-danger">¿Está seguro?</h4>
  <p>¿Está seguro que desea eliminar esta dirección?</p>
  <form method="POST" action="/cliente/direcciones/{{direccion._id}}/eliminar" class="d-flex gap-2 justify-content-center">
    <a href="/cliente/direcciones" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-danger">Aceptar</button>
  </form>
</div>
