<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><a href="/cliente" class="btn btn-sm btn-outline-secondary me-1">Home</a><a href="/cliente/pedidos" class="btn btn-sm btn-outline-secondary me-1">Mis pedidos</a><a href="/cliente/direcciones" class="btn btn-sm btn-primary me-1">Mis direcciones</a><a href="/cliente/favoritos" class="btn btn-sm btn-outline-secondary me-1">Mis favoritos</a><a href="/cliente/perfil" class="btn btn-sm btn-outline-secondary me-1">Mi perfil</a></div><a href="/logout" class="btn btn-sm btn-outline-danger">Cerrar sesión</a></div>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Mis direcciones</h4>
    <a href="/cliente/direcciones/crear" class="btn btn-primary btn-sm">+ Dirección</a>
  </div>

  {{#each direcciones}}
    <div class="card mb-2 p-3 d-flex flex-row justify-content-between align-items-center">
      <div><strong>{{this.nombre}}</strong><div class="text-muted small">{{this.descripcion}}</div></div>
      <div>
        <a href="/cliente/direcciones/{{this._id}}/editar" class="btn btn-sm btn-outline-primary">Editar</a>
        <a href="/cliente/direcciones/{{this._id}}/eliminar" class="btn btn-sm btn-outline-danger">Eliminar</a>
      </div>
    </div>
  {{else}}
    <p>No tienes direcciones guardadas.</p>
  {{/each}}

  <a href="/cliente" class="btn btn-secondary mt-3">Volver</a>
</div>
