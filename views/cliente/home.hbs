<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><a href="/cliente" class="btn btn-sm btn-primary me-1">Home</a><a href="/cliente/pedidos" class="btn btn-sm btn-outline-secondary me-1">Mis pedidos</a><a href="/cliente/direcciones" class="btn btn-sm btn-outline-secondary me-1">Mis direcciones</a><a href="/cliente/favoritos" class="btn btn-sm btn-outline-secondary me-1">Mis favoritos</a><a href="/cliente/perfil" class="btn btn-sm btn-outline-secondary me-1">Mi perfil</a></div><a href="/logout" class="btn btn-sm btn-outline-danger">Cerrar sesión</a></div>
  <h4 class="mb-3">Hola. ¿Qué vas a pedir hoy?</h4>
  <div class="row g-2">
    {{#each tipos}}
      <div class="col-4 col-md-2">
        <a href="/cliente/tipos/{{this._id}}/comercios" class="text-decoration-none text-dark">
          <div class="card text-center h-100">
            <img src="{{this.icono}}" class="card-img-top p-3" style="height:100px; object-fit:contain;">
            <div class="card-body py-2"><span>{{this.nombre}}</span></div>
          </div>
        </a>
      </div>
    {{else}}
      <p>Aún no hay tipos de comercio disponibles.</p>
    {{/each}}
  </div>
</div>
