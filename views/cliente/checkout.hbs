<div class="container mt-3">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="row">
    <div class="col-md-7">
      <h4>Selecciona una dirección</h4>
      <form method="POST" action="/cliente/comercios/{{comercio._id}}/pedir" id="formPedido">
        {{#each direcciones}}
          <div class="form-check border rounded p-2 mb-2">
            <input class="form-check-input" type="radio" name="direccionId" value="{{this._id}}" id="dir{{this._id}}" required>
            <label class="form-check-label" for="dir{{this._id}}"><strong>{{this.nombre}}</strong> — {{this.descripcion}}</label>
          </div>
        {{else}}
          <p>No tienes direcciones guardadas. <a href="/cliente/direcciones/crear">Crea una dirección</a> para poder continuar.</p>
        {{/each}}
      </form>
    </div>

    <div class="col-md-5">
      <div class="card p-3">
        <div class="d-flex align-items-center gap-2 mb-3">
          <img src="{{comercio.foto}}" style="width:40px;height:40px;object-fit:cover;border-radius:50%;">
          <strong>{{comercio.nombreComercio}}</strong>
        </div>
        <div class="d-flex justify-content-between"><span>Subtotal</span><span>RD$ {{subtotal}}</span></div>
        <div class="d-flex justify-content-between"><span>ITBIS</span><span>{{itbisPorcentaje}}%</span></div>
        <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>RD$ {{total}}</span></div>

        {{#if direcciones.length}}
          <button type="submit" form="formPedido" class="btn btn-primary w-100 mt-3">Pedir</button>
        {{/if}}
      </div>
    </div>
  </div>

  <a href="/cliente/comercios/{{comercio._id}}/catalogo" class="btn btn-secondary mt-3">Volver al catálogo</a>
</div>
