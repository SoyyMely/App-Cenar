<div class="container mt-3" style="max-width: 600px;">
  <div class="cenar-header">
  <div class="cenar-logo-icon">
    <img src="/img/cenar-logo-blanco.svg" style="width:22px;height:22px;">
  </div>
  <span class="cenar-logo-text">cenar</span>
</div>
  <div class="text-center mb-4">
    <h3>{{pedido.comercio.nombreComercio}}</h3>
    <span class="badge {{#if (eq pedido.estado 'en_proceso')}}bg-info{{else}}bg-success{{/if}}">{{pedido.estado}}</span>
  </div>

  {{#if (eq pedido.estado 'en_proceso')}}
    <form method="POST" action="/delivery/pedidos/{{pedido._id}}/completar" class="mb-3">
      <button type="submit" class="btn btn-primary w-100">Completar el pedido</button>
    </form>
  {{/if}}

  <div class="card p-3">
    <h5>El pedido</h5>
    {{#each pedido.productos}}
      <div class="d-flex justify-content-between border-bottom py-2"><span>{{this.nombre}}</span><span>RD$ {{this.precio}}</span></div>
    {{/each}}

    {{#if (eq pedido.estado 'en_proceso')}}
      <div class="d-flex align-items-center gap-2 pt-2 border-top mt-2">
        <i class="ti ti-map-pin"></i>
        <div><div class="text-muted small">Dirección</div><strong>{{pedido.direccion.descripcion}}</strong></div>
      </div>
    {{/if}}

    <div class="d-flex justify-content-between fw-bold pt-2"><span>Total</span><span>RD$ {{pedido.total}}</span></div>
  </div>

  <a href="/delivery" class="btn btn-secondary w-100 mt-3">Volver</a>
</div>
